 // ─────────── Messages depuis les content scripts ───────────
 
+// La page « Erreurs » de chrome://extensions n’est lisible que dans le navigateur : on remonte les erreurs à RS-Max.
+const reportedErrors = new Map();
+async function reportError(context, message, stack, page) {
+  const text = String(message || 'Erreur inconnue').slice(0, 1000);
+  const key = context + '|' + text;
+  if (Date.now() - (reportedErrors.get(key) || 0) < 600000) return;
+  reportedErrors.set(key, Date.now());
+  try {
+    await apiFetch({ method: 'POST', path: '/extension/errors', body: { context, message: text,
+      stack: stack ? String(stack).slice(0, 4000) : null, page: page ? String(page).slice(0, 500) : null,
+      version: chrome.runtime.getManifest().version, profile: self.RSMAX_DEFAULTS?.taskProfile || null } });
+  } catch {}
+}
+if (typeof self.addEventListener === 'function') {
+  self.addEventListener('error', (e) => { reportError('worker', e.message, e.error?.stack, null); });
+  self.addEventListener('unhandledrejection', (e) => { reportError('worker', e.reason?.message || String(e.reason), e.reason?.stack, null); });
+}
