+/* Publication vidéo du compositeur RS-Max. Une seule autorisation et un seul clic. */
+(() => {
+  'use strict';
+  const studio = window.RSTikTokPhotos;
+  if (!studio || !window.RSMAX) return;
+  const { wait, identity, guard, readFile, privacy, privacyMatches, captionInput,
+    captionText, visible, buttons, text, sleep } = studio;
+  const ready = post => visible(post) && !post.disabled && post.getAttribute('aria-disabled') !== 'true';
+
+  async function publish(task) {
+    const payload = task.payload;
+    let clicked = false;
+    try {
+      await identity(payload);
+      if (location.pathname !== '/tiktokstudio/upload' || location.search || captionInput() || document.querySelector('table'))
+        throw Error('Un formulaire TikTok vide est requis.');
+      if (payload.media?.length !== 1 || payload.media[0].mimetype !== 'video/mp4')
+        throw Error('Une vidéo MP4 est requise.');
+      const input = await wait(() => document.querySelector('input[type="file"][accept*="video"]'));
+      if (!input) throw Error('Sélecteur vidéo TikTok absent.');
+      const file = await readFile(payload.media[0], 250 * 1024 * 1024);
+      await identity(payload);
+      const transfer = new DataTransfer();
+      transfer.items.add(file);
+      input.files = transfer.files;
+      input.dispatchEvent(new Event('input', {bubbles:true}));
+      input.dispatchEvent(new Event('change', {bubbles:true}));
+
+      const field = await wait(captionInput, 180000);
+      if (!field?.isContentEditable) throw Error('Description vidéo non éditable.');
+      const accepted = () => captionText(captionInput()) === payload.caption &&
+        [...document.querySelectorAll('span,div')].some(el =>
+          visible(el) && new RegExp('^' + payload.caption.length + '\\s*/\\s*4000$').test(text(el)));
+      const checkedWait = async (test, label) => {
+        const result = await wait(test);
+        if (!result) throw Error(label + ' non confirmé.');
+        return result;
+      };
+      await window.RSTikTokCaption.replace(field, payload.caption, {
+        pause:sleep, wait:checkedWait, check:() => guard(payload), accepted, ready:accepted,
+      });
+      await privacy(payload);
+      const postNow = () => document.querySelector('input[type="radio"][value="post_now"]')?.checked === true;
+      const uploaded = () => {
+        const lines = document.body.innerText.split('\n').map(line => line.trim());
+        return lines.includes(file.name) && lines.some(line => /^(?:Uploaded|Importé)(?:\s*[（(][^）)]+[）)])?$/i.test(line));
+      };
+      const post = await wait(() => uploaded() && buttons().find(el => /^(Post|Publier)$/.test(text(el)) && ready(el)), 420000);
+      const safeToSend = () => uploaded() && postNow() && accepted() && privacyMatches(payload) && ready(post);
+      if (!post || !safeToSend()) throw Error('Import, visibilité ou description vidéo non confirmés.');
+
+      const receipt = {media_count:1, source_hashes:[payload.media[0].sha256], text_matched:true};
+      if (payload.dry) return {status:'done', result:{...receipt, rehearsed:true, send_clicked:false}};
+      await window.RSPacing.pause({});
+      await identity(payload);
+      if (!safeToSend()) throw Error('Formulaire vidéo modifié avant envoi.');
+      await window.RSMAX.api.post('/extension/tasks/' + task.id + '/authorize-tiktok-publication', {});
+      guard(payload);
+      if (!safeToSend()) throw Error('Formulaire vidéo modifié après autorisation.');
+      const sent_at = Date.now();
+      clicked = true;
+      post.click();
+      return {status:'done', result:{...receipt, send_clicked:true, sent_at}};
+    } catch (error) {
+      return {status:clicked ? 'uncertain' : 'failed', error:error.message, result:{send_clicked:clicked}};
+    }
+  }
+
+  chrome.runtime.onMessage.addListener((message, _sender, reply) => {
+    if (message?.type !== 'x.task') return false;
+    const task = message.task;
+    if (task?.kind === 'tiktok.video.publish.ready') {
+      reply({status:'done'});
+      return false;
+    }
+    if (task?.kind !== 'tiktok.publish' || task.payload.media_type !== 'video') return false;
+    publish(task).then(reply);
+    return true;
+  });
+})();
