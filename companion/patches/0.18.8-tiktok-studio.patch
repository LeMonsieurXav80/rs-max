+      await wait(1500);
+      if (!profile || !lists) continue;
+      const before = posts.size;
+      // La liste Studio charge la page suivante lorsque sa zone défile.
+      await page.call('Runtime.evaluate', { expression: `(() => {
+        const scrollers = [document.scrollingElement, ...document.querySelectorAll('main,section,div')];
+        for (const el of scrollers) {
+          if (el && el.scrollHeight > el.clientHeight + 40 && el.clientHeight > 160 &&
