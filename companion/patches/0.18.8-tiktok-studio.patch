+
+function count(value) {
+  if (!/^\d+$/.test(String(value ?? ''))) return null;
+  const number = Number(value);
+  return Number.isSafeInteger(number) ? number : null;
+}
+
+function cdn(value) {
+  try {
+    const url = new URL(value);
+    if (url.protocol === 'https:' && !url.username && !url.password && !url.port &&
+        /(^|\.)tiktokcdn(?:-eu|-us)?\.com$/.test(url.hostname)) return url.href;
+  } catch {}
+  return null;
+}
+
+function readPost(item, username, now = Math.floor(Date.now() / 1000)) {
+  const id = item?.item_id;
+  const published = count(item?.post_time);
+  if (typeof id !== 'string' || !/^\d{15,25}$/.test(id) || !published ||
+      published > now || item.status !== 102 || item.visibility !== 1 ||
+      item.in_review !== false || ![1, 2].includes(item.item_type)) return null;
+  const type = item.item_type === 2 ? 'photo' : 'video';
+  const metrics = {};
+  for (const [key, field] of Object.entries({
+    views: 'play_count', likes: 'like_count', comments: 'comment_count',
+    shares: 'share_count', bookmarks: 'favorite_count',
+  })) {
+    const value = count(item[field]);
+    if (value !== null) metrics[key] = value;
+  }
+  const cover = (item.cover_url || []).map(cdn).find(Boolean) || null;
+  const video = (item.play_addr || []).map(cdn).find(Boolean) || null;
+  return {
+    id, type, published_at: published, caption: String(item.desc || '').slice(0, 8000),
+    url: host + '/@' + username + '/' + type + '/' + id, cover, video, metrics,
+  };
+}
