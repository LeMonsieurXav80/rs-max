 intermédiaire, sans IA ni clic public. `x-backlog.cjs` vérifie quatre lots avec
 rechargement de page et progression persistante malgré une nouvelle mention en
 tête, puis le choix de repartir des récentes. Réseau X simulé, profils jetables.
+
+`x-reply-proof.cjs` vérifie la réponse X avec un profil jetable et un serveur HTTPS local. Le parent chargé au second passage confirme le reçu ; un autre parent le laisse incertain. Un clic simulé par cas. Utiliser `RS_CHROMIUM`, `RS_TEST_OUTPUT` et `NODE_PATH` comme ci-dessus.
diff --git a/tests/e2e/x-reply-proof.cjs b/tests/e2e/x-reply-proof.cjs
new file mode 100644
--- /dev/null
+++ b/tests/e2e/x-reply-proof.cjs
@@ -0,0 +1,125 @@
+/* Extension réelle, réseau simulé, profil sans session. */
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const https = require('node:https');
+const {execFileSync} = require('node:child_process');
+const path = require('node:path');
+const {chromium} = require('playwright');
+
+const root = path.resolve(__dirname, '../..');
+const out = process.env.RS_TEST_OUTPUT;
+if (!out || fs.existsSync(path.join(root, 'config.local.js'))) {
+  throw Error('Copie sans configuration privée et dossier de test requis.');
+}
+
+const profileLink = '<a data-testid="AppTabBar_Profile_Link" href="/account">Profil</a>';
+const replyText = 'Merci pour la précision !';
+const post = (id, author, text, parent = '') =>
+  `<article data-testid="tweet"><a href="/${author}/status/${id}"><time>11 h</time></a>
+  ${parent ? `<div data-testid="replyingTo">En réponse à <a href="${parent}">@parent</a></div>` : ''}
+  <div data-testid="tweetText">${text}</div></article>`;
+
+const composer = `<!doctype html><html lang="fr"><meta charset="utf-8">${profileLink}<main>
+  <textarea aria-label="Postez votre réponse"></textarea>
+  <button data-testid="tweetButton">Répondre</button></main><script>
+  document.querySelector('button').onclick = () => {
+    const reply = ((BigInt(Date.now()) - 1288834974657n) << 22n).toString();
+    fetch('/_fixture/click', {method:'POST'});
+    document.querySelector('main').insertAdjacentHTML('beforeend',
+      '<a href="/account/status/' + reply + '">Voir la réponse</a>');
+  };
+  </script></html>`;
+
+async function main() {
+  fs.mkdirSync(out, {recursive:true});
+  const key = path.join(out, 'fixture-key.pem');
+  const cert = path.join(out, 'fixture-cert.pem');
+  execFileSync('openssl', ['req', '-x509', '-newkey', 'rsa:2048', '-nodes',
+    '-keyout', key, '-out', cert, '-days', '1', '-subj', '/CN=x.com'], {stdio:'ignore'});
+  let reads = 0;
+  let clicks = 0;
+  let delayParent = false;
+  const server = https.createServer({key:fs.readFileSync(key), cert:fs.readFileSync(cert)}, (request, response) => {
+    const url = new URL(request.url, 'https://x.com');
+    response.setHeader('Cache-Control', 'no-store');
+    if (url.pathname === '/_fixture/click') {
+      clicks++;
+      response.writeHead(204).end();
+      return;
+    }
+    response.setHeader('Content-Type', 'text/html; charset=utf-8');
+    if (url.pathname === '/compose/post') {
+      response.end(composer);
+      return;
+    }
+    const match = url.pathname.match(/^\/account\/status\/(\d+)$/);
+    if (!match) {
+      response.writeHead(404).end();
+      return;
+    }
+    reads++;
+    const includeParents = !delayParent || reads > 1;
+    const thread = includeParents
+      ? post('100', 'origin', 'Le sujet') + post('200', 'member', 'Une question', '/origin/status/100')
+      : '';
+    const reply = post(match[1], 'account', replyText, '/member/status/200');
+    response.end(`<!doctype html><html lang="fr"><meta charset="utf-8">${profileLink}<main>${thread}${reply}</main></html>`);
+  });
+  await new Promise((resolve, reject) => server.once('error', reject).listen(0, '127.0.0.1', resolve));
+
+  let ctx;
+  try {
+    ctx = await chromium.launchPersistentContext(path.join(out, 'profile'), {
+      executablePath:process.env.RS_CHROMIUM,
+      headless:true,
+      args:[`--disable-extensions-except=${root}`, `--load-extension=${root}`,
+        `--host-resolver-rules=MAP x.com 127.0.0.1:${server.address().port}, MAP * ~NOTFOUND`,
+        '--no-proxy-server', '--ignore-certificate-errors', '--disable-quic']
+    });
+    const worker = ctx.serviceWorkers()[0] || await ctx.waitForEvent('serviceworker');
+    assert.equal(await worker.evaluate(() => chrome.runtime.getManifest().version), '0.18.33');
+    const page = ctx.pages()[0] || await ctx.newPage();
+
+    async function verify(parent, lateParent) {
+      reads = 0;
+      clicks = 0;
+      delayParent = lateParent;
+      const url = `https://x.com/compose/post?in_reply_to=${parent}`;
+      await page.goto(url);
+      await page.bringToFront();
+      const observed = await worker.evaluate(async ({url, replyText}) => {
+        const tab = (await chrome.tabs.query({active:true})).find(tab => tab.url === url);
+        if (!tab) throw Error('Compositeur de test introuvable.');
+        RSTaskJournal.start({id:1, kind:'x.post'});
+        try {
+          const result = await postXInTab({kind:'x.post', payload:{
+            url, username:'account', text:replyText, media:[], require_visible:true
+          }}, tab.id);
+          return {result, trace:RSTaskJournal.finish(result)};
+        } finally {
+          RSTaskJournal.clear();
+        }
+      }, {url, replyText});
+      return {...observed.result, trace:observed.trace, reads, clicks};
+    }
+
+    const proven = await verify('200', true);
+    assert.equal(proven.status, 'done', JSON.stringify(proven));
+    assert.equal(proven.result.proof, 'after_reload');
+    assert.equal(proven.result.parent_id, '200');
+    assert.equal(reads, 2);
+    assert.equal(clicks, 1);
+
+    const wrong = await verify('100', false);
+    assert.equal(wrong.status, 'uncertain', JSON.stringify(wrong));
+    assert.equal(wrong.result.verification.verification.parent_incomplete, false);
+    assert.equal(reads, 1);
+    assert.equal(clicks, 1);
+    console.log('Chromium : parent tardif confirmé, ancêtre incorrect refusé, un clic simulé par réponse.');
+  } finally {
+    await ctx?.close();
+    await new Promise(resolve => server.close(resolve));
+  }
+}
+
+main().catch(error => { console.error(error); process.exitCode = 1; });
