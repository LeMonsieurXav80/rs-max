+async function runLocalFeedTask(taskId) {
+  const task = {...await apiFetch({method:'POST', path:`/extension/feed/tasks/${taskId}/claim`}), local:true};
+  globalThis.RSTaskJournal?.start(task);
+  let outcome;
+  try { outcome = await executeTask(task).catch(e => ({status:'failed', error:e.message})); }
+  finally {
+    const diagnostics = globalThis.RSTaskJournal?.finish(outcome || {status:'uncertain'}) || [];
+    try { await apiFetch({method:'POST', path:`/extension/tasks/${task.id}/finish`, body:{...(outcome || {status:'uncertain', error:'Résultat du geste perdu.'}), diagnostics}}); }
