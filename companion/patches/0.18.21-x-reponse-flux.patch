@@ -14,3 +14,52 @@ test('X : retrouver la même cible après un démontage React pendant la pause,
 test('X : auteur différent refusé et like déjà présent conservé',async()=>{
  for(const options of [{author:'other'},{liked:true}]){const f=fixture(options);try{const r=await f.w.RSXAgent.run('x.agent.act',f.payload);assert.equal(f.clicks(),0);if(options.liked)assert.equal(r.result.unchanged,true);else assert.equal(r.status,'failed')}finally{f.dom.window.close()}}
 });
+
+function nativeReply(f, {changedTarget=false}={}) {
+  const {w}=f;
+  let submissions=0;
+  const reply=w.document.createElement('a');
+  reply.href='/compose/post?in_reply_to=123';
+  reply.textContent='Répondre';
+  f.w.document.querySelector('article').append(reply);
+  reply.onclick=event=>{
+    event.preventDefault();
+    w.history.pushState({},'',reply.href);
+    const dialog=w.document.createElement('div');
+    dialog.setAttribute('role','dialog');
+    dialog.innerHTML='<textarea aria-label="Votre réponse"></textarea><button>Répondre</button>';
+    w.document.body.append(dialog);
+    if(changedTarget)dialog.querySelector('textarea').addEventListener('input',()=>{
+      w.history.replaceState({},'','/compose/post?in_reply_to=456');
+    });
+    dialog.querySelector('button').onclick=()=>{
+      submissions++;
+      dialog.remove();
+      const receipt=w.document.createElement('a');
+      receipt.href='/owner/status/999';
+      receipt.textContent='Voir';
+      w.document.body.append(receipt);
+    };
+  };
+  return {payload:{...f.payload,action:'reply',text:'J’aime ce détail !'},submissions:()=>submissions};
+}
+
+test('X : le compositeur natif prouve la cible par sa route et relève le lien du reçu',async()=>{
+  const f=fixture(),reply=nativeReply(f);
+  try{
+    const result=await f.w.RSXAgent.run('x.agent.act',reply.payload);
+    assert.equal(result.status,'done',JSON.stringify(result));
+    assert.equal(result.result.reply_id,'999');
+    assert.equal(reply.submissions(),1);
+  }finally{f.dom.window.close()}
+});
+
+test('X : une route de réponse modifiée après saisie interdit le clic',async()=>{
+  const f=fixture(),reply=nativeReply(f,{changedTarget:true});
+  try{
+    const result=await f.w.RSXAgent.run('x.agent.act',reply.payload);
+    assert.equal(result.status,'failed');
+    assert.equal(result.result.gesture,false);
+    assert.equal(reply.submissions(),0);
+  }finally{f.dom.window.close()}
+});
