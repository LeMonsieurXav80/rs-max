+    if (!profile.avatar) {
+      const avatar = await page.call('Runtime.evaluate', { expression: `document
+        .querySelector('[data-tt="Header_NewHeader_Clickable"] img')?.src || null`, returnByValue: true });
+      profile.avatar = cdn(avatar.result.value);
+    }
+
+
+    if (analytics) {
+      await page.call('Page.navigate', { url: host + '/tiktokstudio/analytics' });
+      const deadline = Date.now() + 17000;
+      while (followerCount === null && !wrongIdentity && Date.now() < deadline) await wait(600);
+      if (wrongIdentity) throw Error('Compte Studio différent pendant la lecture.');
+    }
+
+    return { ...profile, followers_count: followerCount, has_more: hasMore,
+      posts: [...posts.values()].sort((a, b) => b.published_at - a.published_at).slice(0, limit) };
+  } finally {
+    page?.close();
+    if (id) await browser.call('Target.closeTarget', { targetId: id }).catch(() => {});
+    browser.close();
+  }
+}
