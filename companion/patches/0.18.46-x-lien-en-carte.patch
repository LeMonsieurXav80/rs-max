 const cardText = 'Dans cette vidéo, je te montre les pièges.\n\nhttps://www.youtube.com/watch?v=6VT92sKqy88';
 const cardArticle = card => `<article data-testid="tweet"><a href="/owner/status/500"><time>1 min</time></a>
+  <div data-testid="tweetText">Dans cette vidéo, je te montre les pièges.</div>${card}</article>`;
+
+test('un lien final affiché en carte est reconnu sans figurer dans le texte', async () => {
+  const w = browser(cardArticle('<div data-testid="card.wrapper"><a href="https://t.co/cPG1Wy6LPE">youtube.com</a></div>'));
+  const r = await w.RSXPublisher.verify({id:'500', username:'owner', text:cardText, url:'https://x.com/compose/post'});
+  assert.equal(r.result.confirmed, true, JSON.stringify(r));
+});
+
+test('sans carte, un texte privé de son lien final ne prouve rien', async () => {
+  const w = browser(cardArticle(''));
+  const r = await w.RSXPublisher.verify({id:'500', username:'owner', text:cardText, url:'https://x.com/compose/post'});
+  assert.equal(r.result.confirmed, false);
+});
