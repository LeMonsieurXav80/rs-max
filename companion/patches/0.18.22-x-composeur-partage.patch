+async function executeXAgentReply(task,tabId) {
+  const {target,username}=task.payload;
+  if(!/^[0-9]+$/.test(String(target?.id||''))||!username||!target.author||target.author.toLowerCase()===username.toLowerCase()){
+    return {status:'failed',result:{gesture:false},error:'Destinataire X invalide.'};
+  }
+  const read=await askPage(tabId,{kind:'x.agent.read',payload:{...task.payload,action:'thread.read',target_id:target.id}});
+  const current=read?.result?.target;
+  if(read?.status!=='done'||read.result?.context_complete!==true||current?.id!==target.id
+    ||current.author!==target.author||current.text!==target.text){
+    return {status:'failed',result:{gesture:false},error:read?.error||'Publication ciblée modifiée ou non vérifiée.'};
+  }
+  if(read.result.visible_replies?.some(post=>post.author===username.toLowerCase())){
+    return {status:'failed',result:{gesture:false},error:'Le compte a déjà répondu à la publication.'};
+  }
+
+  const url='https://x.com/compose/post?in_reply_to='+target.id;
+  await reloadTaskTab(tabId,url);
+  const proof=await postXInTab({...task,kind:'x.post',payload:{...task.payload,url,media:[]}},tabId);
+  if(proof?.status!=='done'||proof.result?.confirmed!==true)return proof;
+  const replyId=proof.result.id;
+  if(proof.result.parent_id!==target.id||!/^[0-9]+$/.test(String(replyId||''))){
+    return {status:'uncertain',result:proof.result,error:'La réponse X et sa cible ne sont pas prouvées : aucun renvoi.'};
+  }
+  const replyUrl='https://x.com/'+username+'/status/'+replyId;
+  return {...proof,result:{...proof.result,reply_id:replyId,reply_url:replyUrl,post_id:replyId,post_url:replyUrl}};
+}
+
+async function postXInTab(task,tabId) {
+  await askPage(tabId,{kind:'x.ready',payload:{}});
+  // Une écriture ne passe jamais dans askPage, dont la reprise est réservée aux lectures.
+  let outcome;
+  try {outcome=await chrome.tabs.sendMessage(tabId,{type:'x.task',task});}
+  catch(e){return {status:'uncertain',error:'Résultat de publication perdu : aucun renvoi. '+e.message};}
+  if(outcome?.status!=='done'||task.payload.dry)return outcome||{status:'uncertain',error:'Résultat de publication absent.'};
+  let p={...task.payload,...outcome.result};
+  if(!p.id){
+    await reloadTaskTab(tabId,'https://x.com/'+p.username);
+    const found=await askPage(tabId,{kind:'x.post.locate',payload:p});
+    p.id=found?.result?.id;if(found?.result?.platform_limit)p.platform_limit=found.result.platform_limit;
+  }
+  if(!/^[0-9]+$/.test(String(p.id||'')))return {status:'uncertain',result:{...outcome.result,...p.platform_limit?{platform_limit:p.platform_limit}:{}},error:'Post non retrouvé : vérifier sans renvoyer.'};
+  await reloadTaskTab(tabId,'https://x.com/'+p.username+'/status/'+p.id);
+  globalThis.RSTaskJournal?.mark('proof.after_reload');
+  const proof=await askPage(tabId,{kind:'x.post.verify',payload:p});
+  return proof?.result?.confirmed===true?proof:{status:'uncertain',result:{id:p.id,started_at:p.started_at,verification:proof?.result||null,...(proof?.result?.platform_limit?{platform_limit:proof.result.platform_limit}:{})},error:'Publication non prouvée après rechargement : aucun renvoi.'};
+}
