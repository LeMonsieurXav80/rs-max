+'use strict';
+const http = require('node:http'), fs = require('node:fs'), crypto = require('node:crypto');
+const {perform} = require('./input.cjs');
+const {verifyPublic} = require('./public.cjs');
+function createServer(config, handlers = {perform, verifyPublic}) {
+  if (!/^[a-f0-9]{64}$/.test(config.nativeInputToken || '') || !/^chrome-extension:\/\/[a-p]{32}$/.test(config.nativeInputOrigin || '')) throw Error('Configuration native NAS absente');
+  let busy = false;
+  return http.createServer(async (req, res) => {
+    const auth = Buffer.from(req.headers.authorization || ''), expected = Buffer.from('Bearer '+config.nativeInputToken), allowed = req.headers.origin === config.nativeInputOrigin;
+    res.setHeader('Content-Type','application/json'); res.setHeader('Cache-Control','no-store');
+    if (!allowed) { res.writeHead(403); return res.end('{"error":"Origine refusée"}'); }
+    res.setHeader('Access-Control-Allow-Origin', config.nativeInputOrigin);
+    if (req.method === 'OPTIONS') { res.setHeader('Access-Control-Allow-Methods','POST');res.setHeader('Access-Control-Allow-Headers','Authorization, Content-Type');res.writeHead(204);return res.end(); }
+    if (auth.length !== expected.length || !crypto.timingSafeEqual(auth,expected)) {res.writeHead(403);return res.end('{"error":"Accès refusé"}');}
+    if (req.method !== 'POST' || !['/tiktok/fill','/tiktok/send','/tiktok/verify','/tiktok/health'].includes(req.url)) {res.writeHead(404);return res.end('{}');}
+    if (busy) {res.writeHead(409);return res.end('{"error":"Opération native déjà en cours"}');}
+    busy=true;
+    try { let body=''; for await (const part of req) {body+=part;if(body.length>16000){res.writeHead(413);return res.end('{}');}} const s=JSON.parse(body);const value=req.url.endsWith('/health')?{ready:true,version:'0.18.5'}:req.url.endsWith('/verify')?await handlers.verifyPublic(s):await handlers.perform(req.url.split('/').at(-1),s);res.end(JSON.stringify(value)); }
+    catch {res.writeHead(409);res.end('{"error":"Opération native refusée ou interrompue : vérifier sans renvoyer"}');}
+    finally {busy=false;}
+  });
+}
