diff --git a/tests/x-publisher-links.test.cjs b/tests/x-publisher-links.test.cjs
new file mode 100644
index 0000000..673e8b1
--- /dev/null
+++ b/tests/x-publisher-links.test.cjs
@@ -0,0 +1,31 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {JSDOM} = require('jsdom');
+
+function browser(html) {
+  const dom = new JSDOM(`<main>${html}</main>`, {url:'https://x.com/owner/status/500', runScripts:'outside-only', pretendToBeVisual:true});
+  const w = dom.window;
+  w.HTMLElement.prototype.getClientRects = () => [{}];
+  w.scrollTo = () => {};
+  w.RSMAX = {};
+  w.RSXMentions = {identity:() => ({username:'owner'})};
+  for (const name of ['dom', 'thread-context', 'agent', 'publisher']) w.eval(readFileSync(join(__dirname, '../x', name+'.js'), 'utf8'));
+  return w;
+}
+const text = 'Le guide est en ligne.\nhttps://www.laplanetedecaro.com/black-friday-zendure/\nLiens affiliés.';
+const article = link => `<article data-testid="tweet"><a href="/owner/status/500"><time>1 min</time></a>
+  <div data-testid="tweetText">Le guide est en ligne.<br>${link}<br>Liens affiliés.</div></article>`;
+
+test('une publication dont X raccourcit le lien est reconnue après rechargement', async () => {
+  const w = browser(article('<a href="https://t.co/AbC123"><span aria-hidden="true">https://www.</span>laplanetedecaro.com/black-fri<span aria-hidden="true">day-zendure/</span>…</a>'));
+  const r = await w.RSXPublisher.verify({id:'500', username:'owner', text, url:'https://x.com/compose/post'});
+  assert.equal(r.result.confirmed, true, JSON.stringify(r));
+});
+
+test('un lien raccourci vers une autre adresse ne prouve rien', async () => {
+  const w = browser(article('<a href="https://t.co/AbC123">laplanetedecaro.com/autre-article/</a>'));
+  const r = await w.RSXPublisher.verify({id:'500', username:'owner', text, url:'https://x.com/compose/post'});
+  assert.equal(r.result.confirmed, false);
+});
