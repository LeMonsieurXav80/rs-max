+test('le reçu est rattaché uniquement à la saisie active et son texte est supprimé',async()=>{const d=new JSDOM('',{runScripts:'outside-only'}),w=d.window;w.eval(fs.readFileSync(path.join(__dirname,'../tiktok/submission-receipt.js'),'utf8'));const receipt=w.RSTikTokSubmission.start('Merci 😊');const emit=b=>w.dispatchEvent(new w.CustomEvent('rsmax:tiktok:submission',{detail:JSON.stringify(b)}));emit({text:'Autre message',comment_id:'999'});emit({text:'Merci 😊',http_status:200,status_code:0,comment_status:2,comment_id:'7705842946607711009',parent_id:'123',post_id:'456',cookie:'NEVER'});const value=await receipt.finish();assert.equal(value.comment_status,2);assert.equal(value.comment_id,'7705842946607711009');assert.equal(value.text_matched,true);assert.equal(value.confirmed,undefined);assert.ok(!JSON.stringify(value).includes('NEVER'));assert.equal(value.text,undefined);d.window.close()});
