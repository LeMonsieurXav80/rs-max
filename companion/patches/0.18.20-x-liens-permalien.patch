diff --git a/tests/x-dom-role-link.test.cjs b/tests/x-dom-role-link.test.cjs
new file mode 100644
index 0000000..1b9be94
--- /dev/null
+++ b/tests/x-dom-role-link.test.cjs
@@ -0,0 +1,23 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {JSDOM} = require('jsdom');
+
+test('X reconnaît le permalien daté malgré role=link et écarte la citation', () => {
+  const dom = new JSDOM('<main><article data-testid="tweet"><a role="link" href="/visitor">Visiteur</a><a role="link" href="/visitor/status/123"><time datetime="2026-11-10T07:00:00Z"></time></a><div data-testid="tweetText">Bonjour</div><div role="link"><a role="link" href="/other/status/456"><time></time></a><div data-testid="tweetText">Citation</div></div></article></main>', {
+    url: 'https://x.com/visitor/status/123',
+    runScripts: 'outside-only',
+  });
+  try {
+    const {window} = dom;
+    window.eval(readFileSync(join(__dirname, '../x/dom.js'), 'utf8'));
+    const row = window.RSXDom.snapshot(window.document.querySelector('article'));
+    assert.equal(row.id, '123');
+    assert.equal(row.name, 'Visiteur');
+    assert.equal(row.text, 'Bonjour');
+    assert.equal(row.quote, 'Citation');
+  } finally {
+    dom.window.close();
+  }
+});
