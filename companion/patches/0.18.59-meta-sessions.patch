+/* Cookies confinés au service worker. Aucun identifiant secret n'est envoyé aux pages. */
+(() => {
+  'use strict';
+  const supported = p => ['facebook', 'instagram'].includes(p);
+  function fromCookies(cookies, platform) {
+    if (!supported(platform)) throw Error('Réseau Meta inconnu.');
+    const values = new Map(), domain = new RegExp('^\\.?([a-z0-9-]+\\.)*'+platform+'\\.com$','i');
+    for (const c of cookies) {
+      if (!domain.test(c.domain)) throw Error('Domaine de session Meta refusé.');
+      if (values.has(c.name) && values.get(c.name) !== c.value) throw Error('Cookies Meta contradictoires : vérifier la session.');
+      values.set(c.name,c.value);
+    }
+    const id = platform === 'facebook' ? (values.get('i_user') || values.get('c_user')) : values.get('ds_user_id');
+    const auth = platform === 'facebook' ? values.get('xs') && values.get('c_user') : values.get('sessionid');
+    return auth && /^\d{1,30}$/.test(id || '') ? id : null;
+  }
+  function senderPlatform(sender) {
+    if (sender.id !== chrome.runtime.id || (sender.frameId ?? 0) !== 0) throw Error('Origine de session Meta refusée.');
+    const url = new URL(sender.tab?.url || 'about:blank');
+    if (url.protocol !== 'https:') throw Error('Session Meta en HTTPS obligatoire.');
+    if (/^(www\.|web\.)?facebook\.com$/.test(url.hostname)) return 'facebook';
+    if (/^(www\.)?instagram\.com$/.test(url.hostname)) return 'instagram';
+    throw Error('Origine de session Meta refusée.');
+  }
+  async function identity(sender) {
+    const platform = senderPlatform(sender);
+    const cookies = await chrome.cookies.getAll({domain:platform+'.com'});
+    const accountId = fromCookies(cookies, platform);
+    if (!accountId) throw Error('Connectez ce compte '+platform+' dans Chrome.');
+    const page = await chrome.tabs.sendMessage(sender.tab.id,{type:'x.task',task:{kind:platform+'.whoami',payload:{}}});
+    if (page?.status !== 'done') throw Error(page?.error || 'Identité de la page indisponible.');
+    if (platform === 'facebook' && page.result?.account_id !== accountId) throw Error('Le profil Facebook actif diffère de la session.');
+    if (platform === 'instagram' && !page.result?.username) throw Error('Nom Instagram connecté indisponible.');
+    const after = fromCookies(await chrome.cookies.getAll({domain:platform+'.com'}),platform);
+    if (after !== accountId) throw Error('Compte changé pendant la vérification.');
+    return {platform,account_id:accountId,username:page.result?.username || null,name:page.result?.name || null};
+  }
+  async function send(msg,sender) {
+    if (self.RSMAX_DEFAULTS?.taskProfile) throw Error('Transmettez la session depuis votre Chrome local.');
+    const who = await identity(sender);
+    const cookies = await chrome.cookies.getAll({domain:who.platform+'.com'});
+    if (fromCookies(cookies,who.platform) !== who.account_id) throw Error('Compte changé avant transmission.');
+    return apiFetch({method:'POST',path:'/extension/meta/'+who.platform+'/session',timeoutMs:100000,body:{platform_account_id:who.account_id,
+      cookies:cookies.map(({name,value,domain,path,expirationDate,httpOnly,secure,sameSite,hostOnly})=>({name,value,domain,path,expirationDate,httpOnly,secure,sameSite,hostOnly}))}});
+  }
+  async function execute(task) {
+    const platform = task.kind.split('.')[0];
+    if (!supported(platform) || !task.account_id) throw Error('Identité de tâche Meta absente.');
+    let id = fromCookies(await chrome.cookies.getAll({domain:platform+'.com'}),platform);
+    if (task.kind.endsWith('.session.apply') || id !== task.account_id) {
+      if (task.local) throw Error('Le compte ouvert dans Chrome ne correspond pas : aucun changement de session locale.');
+      const data = await apiFetch({path:'/extension/tasks/'+task.id+'/session'});
+      if (fromCookies(data.cookies || [],platform) !== task.account_id) throw Error('Session enregistrée pour un autre compte.');
+      for (const c of await chrome.cookies.getAll({domain:platform+'.com'})) await chrome.cookies.remove({url:'https://'+c.domain.replace(/^\./,'')+(c.path||'/'),name:c.name});
+      await applySession(data.cookies);
+    }
+    const tabId = await taskTab('https://www.'+platform+'.com/');
+    try {
+      const page = await askPage(tabId,{kind:platform+'.whoami',payload:{}});
+      id = fromCookies(await chrome.cookies.getAll({domain:platform+'.com'}),platform);
+      if (page?.status !== 'done' || id !== task.account_id || (platform === 'facebook' && page.result?.account_id !== id)) throw Error('Identité Meta non confirmée dans la page : aucun geste.');
+      return {status:'done',result:{...page.result,account_id:id}};
+    } finally { await chrome.tabs.remove(tabId).catch(()=>{}); }
+  }
+  self.RSMetaSession = {fromCookies,senderPlatform,identity,send,execute};
+})();
