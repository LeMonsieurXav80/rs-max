diff --git a/native/x-public-profile.cjs b/native/x-public-profile.cjs
new file mode 100644
index 0000000..29a9b9e
--- /dev/null
+++ b/native/x-public-profile.cjs
@@ -0,0 +1,62 @@
+'use strict';
+
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {connect} = require('./cdp.cjs');
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
+
+async function readPublicProfile({username, screens}) {
+  if (typeof username !== 'string' || !/^[a-zA-Z0-9_]{1,15}$/.test(username)
+      || !Number.isInteger(screens) || screens < 1 || screens > 10) {
+    throw Error('Profil X ou nombre d’écrans invalide.');
+  }
+  const handle = username.toLowerCase();
+  const base = 'http://127.0.0.1:9222';
+  const browser = await connect((await (await fetch(base + '/json/version')).json()).webSocketDebuggerUrl);
+  let context, page;
+  try {
+    context = (await browser.call('Target.createBrowserContext', {disposeOnDetach: true})).browserContextId;
+    const {targetId} = await browser.call('Target.createTarget', {url: 'about:blank', browserContextId: context, background: true});
+    let tab;
+    for (let i = 0; i < 20 && !tab; i++) {
+      tab = (await (await fetch(base + '/json')).json()).find(t => t.id === targetId);
+      if (!tab) await sleep(100);
+    }
+    if (!tab) throw Error('Chromium n’a pas ouvert le profil X public.');
+    page = await connect(tab.webSocketDebuggerUrl);
+    await page.call('Page.navigate', {url: 'https://x.com/' + handle});
+
+    const sources = readFileSync(join(__dirname, '../x/dom.js'), 'utf8') + '\n;'
+      + 'window.RSMAX ??= {}; window.chrome ??= {}; window.chrome.runtime ??= {}; window.chrome.runtime.onMessage ??= {addListener() {}};\n'
+      + readFileSync(join(__dirname, '../x/tasks.js'), 'utf8');
+    const scan = sources + '\n;(() => {'
+      + 'const handle = ' + JSON.stringify(handle) + ';'
+      + 'if (location.origin !== "https://x.com" || location.pathname.toLowerCase().replace(/\\/$/, "") !== "/" + handle) return [];'
+      + 'return window.RSXDom.articles().map(article => window.RSXTasks.profileTweet(article, handle)).filter(Boolean);'
+      + '})()';
+    const found = new Map();
+    const collect = async () => {
+      const result = await page.call('Runtime.evaluate', {expression: scan, returnByValue: true});
+      for (const post of result.result?.value || []) {
+        if (post.classification_known && post.stats) found.set(post.id, post);
+      }
+    };
+    for (let i = 0; i < 20 && !found.size; i++) {
+      await sleep(1000);
+      await collect().catch(() => {});
+    }
+    if (!found.size) throw Error('Flux de publications X public indisponible.');
+    for (let i = 1; i < screens; i++) {
+      await page.call('Runtime.evaluate', {expression: 'window.scrollBy(0, Math.round(innerHeight * 1.3))'});
+      await sleep(1600);
+      await collect();
+    }
+    return {tweets: [...found.values()], followers: null, source: 'nas_public_browser'};
+  } finally {
+    page?.close();
+    if (context) await browser.call('Target.disposeBrowserContext', {browserContextId: context}).catch(() => {});
+    browser.close();
+  }
+}
+
+module.exports = {readPublicProfile};
