diff --git a/tests/x-agent-reply-task.test.cjs b/tests/x-agent-reply-task.test.cjs
new file mode 100644
index 0000000..9a1de33
--- /dev/null
+++ b/tests/x-agent-reply-task.test.cjs
@@ -0,0 +1,70 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {runInNewContext} = require('node:vm');
+
+const source = readFileSync(join(__dirname, '../background.js'), 'utf8');
+const replyPath = source.slice(source.indexOf('async function executeXAgentReply('), source.indexOf('async function askPage('));
+const target = {id:'123', author:'auteur', text:'Une publication', url:'https://x.com/auteur/status/123'};
+const task = {id:8, kind:'x.agent.act', payload:{action:'reply', username:'compte', target, url:target.url, text:'Une réponse'}};
+
+function fixture({current=target, replies=[], failToReceive=false}={}) {
+  const navigation = [];
+  const sends = [];
+  const requests = [];
+  const sandbox = {
+    reloadTaskTab: async (tabId,url) => navigation.push({tabId,url}),
+    askPage: async (tabId, request) => {
+      requests.push({tabId, request});
+      if (request.kind === 'x.agent.read') {
+        return {status:'done',result:{context_complete:true,target:current,visible_replies:replies}};
+      }
+      if (request.kind === 'x.post.verify') {
+        return {status:'done',result:{id:'789',confirmed:true,proof:'after_reload',parent_id:'123'}};
+      }
+      assert.equal(request.kind, 'x.ready');
+    },
+    chrome:{tabs:{sendMessage:async (tabId, message) => {
+      sends.push({tabId, message});
+      if (failToReceive) throw Error('Réponse perdue');
+      return {status:'done',result:{id:'789',sent_once:true}};
+    }}},
+  };
+  runInNewContext(replyPath, sandbox);
+  return {run:()=>sandbox.executeXAgentReply(task,42),navigation,sends,requests};
+}
+
+test('X transmet une seule réponse au compositeur existant et confirme son parent', async () => {
+  const f = fixture();
+  const result = await f.run();
+  assert.equal(f.requests[0].request.payload.target_id, target.id);
+  assert.deepEqual(f.navigation.map(item=>item.url), [
+    'https://x.com/compose/post?in_reply_to=123',
+    'https://x.com/compte/status/789',
+  ]);
+  assert.equal(f.sends.length, 1);
+  assert.equal(f.sends[0].message.task.id, task.id);
+  assert.equal(f.sends[0].message.task.kind, 'x.post');
+  assert.equal(f.sends[0].message.task.payload.text, task.payload.text);
+  assert.equal(result.result.reply_url, 'https://x.com/compte/status/789');
+  assert.equal(result.result.parent_id, target.id);
+  assert.equal(result.result.proof, 'after_reload');
+});
+
+test('X refuse un post changé ou déjà commenté avant toute écriture', async () => {
+  for (const options of [{current:{...target,text:'Texte modifié'}},{replies:[{author:'compte'}]}]) {
+    const f = fixture(options);
+    const result = await f.run();
+    assert.equal(result.status, 'failed');
+    assert.equal(result.result.gesture, false);
+    assert.equal(f.sends.length, 0);
+    assert.equal(f.navigation.length, 0);
+  }
+});
+
+test('X conserve un résultat incertain sans renvoyer la publication', async () => {
+  const f = fixture({failToReceive:true});
+  assert.equal((await f.run()).status, 'uncertain');
+  assert.equal(f.sends.length, 1);
+});
