+/** Nouvelle version copiée sur le disque : se recharger entre deux tâches, jamais pendant l'une d'elles. */
+async function reloadIfUpdated() {
+  try {
+    const disk = (await (await fetch(chrome.runtime.getURL('manifest.json'), {cache: 'no-store'})).json()).version;
+    if (disk && disk !== chrome.runtime.getManifest().version && !nativeTask) {
+      console.info(`[rsmax] Companion ${chrome.runtime.getManifest().version} → ${disk} : rechargement entre deux tâches.`);
+      chrome.runtime.reload();
+      return true;
+    }
+  } catch {}
+  return false;
+}
