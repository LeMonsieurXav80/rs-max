+const sessionHostOnly = c => typeof c.hostOnly === 'boolean' ? c.hostOnly : !c.domain.startsWith('.');
+async function removeHostOnlyShadows(cookies) {
+  let removed=0;
+  for(const c of cookies.filter(sessionHostOnly)) {
+    const host=c.domain.replace(/^\./,''),path=c.path||'/';
+    if(cookies.some(other=>other.name===c.name&&(other.path||'/')===path&&other.domain.replace(/^\./,'')===host&&!sessionHostOnly(other)))continue;
