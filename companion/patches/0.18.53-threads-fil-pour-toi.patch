--- a/tests/threads-feed-markers.test.cjs	1970-01-01 01:00:00
+++ b/tests/threads-feed-markers.test.cjs	2026-11-14 14:46:31
@@ -0,0 +1,59 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {JSDOM} = require('jsdom');
+
+// Structure relevée sur le NAS le 14/11/2026 : un bloc par entrée du fil, une réponse dans le bloc de sa publication.
+const card = (author, id, body, extra = '') => `<div><div data-pressable-container="true">
+  <a href="/@${author}"><img width="36" alt="${author}'s profile picture"></a>
+  <a href="/@${author}"><span dir="auto" translate="no"><span>${author}</span></span></a>${extra}
+  <span dir="auto"><a href="/@${author}/post/${id}"><time datetime="2026-11-14T10:00:00.000Z"><span>1h</span></time></a></span>
+  ${body}
+  <div role="button"><svg aria-label="Like"></svg></div><div role="button"><svg aria-label="Reply"></svg></div>
+</div></div>`;
+const unit = cards => `<div>${cards.join('')}</div>`;
+
+function rows(html) {
+  const dom = new JSDOM(`<main>${html}</main>`, {url: 'https://www.threads.com/', runScripts: 'outside-only'});
+  try {
+    dom.window.Element.prototype.getClientRects = () => [{}];
+    dom.window.chrome = {runtime: {onMessage: {addListener() {}}}};
+    dom.window.eval(readFileSync(join(__dirname, '../threads/agent.js'), 'utf8'));
+    return Object.fromEntries(dom.window.RSThreads.snapshots().map(v => [v.s.author, v.s]));
+  } finally {
+    dom.window.close();
+  }
+}
+
+test('le fil Threads porte la traduction proposée, le sujet, les médias décrits et la langue de l’interface', () => {
+  const {coach} = rows(unit([card('coach', 'DfAAA1', `<span dir="auto"><span>Belle séance de squat</span>&nbsp;<div><div role="button"><span>Translate</span></div></div></span>
+    <a href="/@coach/post/DfAAA1/media"><img width="1000" alt="Photo by Coach. May be an image of one or more people and gym."></a>`,
+  '<a href="/search?q=fitness&serp_type=tags&tag_id=1"><span>Fitness Threads</span></a>')]));
+  assert.equal(coach.text, 'Belle séance de squat');
+  assert.equal(coach.translatable, true);
+  assert.equal(coach.ui_lang, 'en');
+  assert.equal(coach.topic, 'Fitness Threads');
+  assert.deepEqual([...coach.media], ['Photo by Coach. May be an image of one or more people and gym.']);
+  assert.equal(coach.promoted, false);
+  assert.equal(coach.reply_hint, undefined);
+});
+
+test('une réponse affichée sous sa publication est marquée, la publication d’origine ne l’est pas', () => {
+  const posts = rows(unit([card('alice', 'DfBBB1', '<span dir="auto"><span>Leg day</span></span>')])
+    + unit([card('bob', 'DfCCC1', '<span dir="auto"><span>Not going to let this get to me</span></span>'),
+      card('carol', 'DfCCC2', '<span dir="auto"><span>💕</span></span>')]));
+  assert.equal(posts.alice.reply_hint, undefined);
+  assert.equal(posts.alice.translatable, false);
+  assert.equal(posts.bob.reply_hint, undefined);
+  assert.equal(posts.carol.reply_hint, true);
+  assert.equal(posts.carol.reply_to, 'bob');
+});
+
+test('publicité et repost sont reconnus à leur mention', () => {
+  const posts = rows(unit([card('brand', 'DfDDD1', '<span dir="auto"><span>Nouvelle collection</span></span>', '<span>Sponsored</span>')])
+    + unit([card('dana', 'DfEEE1', '<span dir="auto"><span>WOD du jour</span></span>', '<div><span>coach reposted</span></div>')]));
+  assert.equal(posts.brand.promoted, true);
+  assert.equal(posts.dana.reposted_by, 'coach');
+  assert.equal(posts.dana.promoted, false);
+});
