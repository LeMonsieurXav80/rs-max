+  }
+  window.RSTikTokNativeInput={async prepare(task,item) {
+    if(!task)return null;
+    const available=await request(task,'available');if(!available.enabled){if(available.required)throw Error('Transport natif requis mais indisponible.');return null;}
+    const nonce=crypto.randomUUID(),avatar=document.querySelector('[data-tt="Header_NewHeader_Clickable"] img')?.getAttribute('src')?.split('?')[0];
