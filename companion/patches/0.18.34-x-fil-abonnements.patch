diff --git a/tests/x-feed.test.cjs b/tests/x-feed.test.cjs
new file mode 100644
--- /dev/null
+++ b/tests/x-feed.test.cjs
@@ -0,0 +1,69 @@
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {test} = require('node:test');
+const {JSDOM} = require('jsdom');
+
+const article = id => `<article><a href="/visitor/status/${id}"><time datetime="2026-11-11T10:00:00Z">1 h</time></a>
+  <div data-testid="tweetText">Une publication</div></article>`;
+
+function fixture() {
+  const dom = new JSDOM(`<main><nav></nav>${article('101')}</main>`, {
+    url:'https://x.com/home', runScripts:'outside-only', pretendToBeVisual:true
+  });
+  const w = dom.window;
+  w.HTMLElement.prototype.getClientRects = () => [{}];
+  w.scrollTo = () => {};
+  w.scrollBy = () => {};
+  w.RSXMentions = {identity:() => ({username:'owner'})};
+  w.RSXLimits = {assert() {}};
+  w.RSMAX = {};
+  for (const name of ['dom', 'agent']) {
+    w.eval(readFileSync(join(__dirname, '../x', name+'.js'), 'utf8'));
+  }
+  return {dom, w, nav:w.document.querySelector('nav'), read:feed =>
+    w.RSXAgent.run('x.agent.read', {action:'feed.read', feed, username:'owner', limit:1, screens:1})};
+}
+
+test('X attend que l’onglet Abonnements soit monté après l’identité', async () => {
+  const f = fixture();
+  try {
+    f.w.setTimeout(() => { f.nav.innerHTML = '<div role="tab" aria-selected="true">Abonné</div>'; }, 300);
+    const result = await f.read('following');
+    assert.equal(result.status, 'done', JSON.stringify(result));
+    assert.equal(result.result.feed, 'following');
+    assert.equal(result.result.items[0].id, '101');
+  } finally { f.dom.window.close(); }
+});
+
+test('X attend les nouvelles publications même si l’onglet change avant le fil', async () => {
+  const f = fixture();
+  try {
+    f.nav.innerHTML = '<div role="tab" aria-selected="true">Pour vous</div><div role="tab" aria-selected="false">Abonnements</div>';
+    const [forYou, following] = f.nav.children;
+    let clicks = 0;
+    following.onclick = () => {
+      clicks++;
+      forYou.setAttribute('aria-selected', 'false');
+      following.setAttribute('aria-selected', 'true');
+      f.w.setTimeout(() => {
+        f.w.document.querySelector('article a').href = '/visitor/status/102';
+      }, 1600);
+    };
+    const result = await f.read('following');
+    assert.equal(result.status, 'done', JSON.stringify(result));
+    assert.equal(result.result.items[0].id, '102');
+    assert.equal(clicks, 1);
+  } finally { f.dom.window.close(); }
+});
+
+test('X abandonne une lecture si la page quitte Accueil pendant le chargement', async () => {
+  const f = fixture();
+  try {
+    f.w.setTimeout(() => f.w.history.replaceState({}, '', '/search?q=exemple'), 50);
+    const result = await f.read('following');
+    assert.equal(result.status, 'failed');
+    assert.match(result.error, /page du fil X a changé/);
+    assert.equal(result.result.items, undefined);
+  } finally { f.dom.window.close(); }
+});
