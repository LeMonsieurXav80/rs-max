+/* Même identification sur le Mac et le VPS ; seuls les cookies restent au service worker. */
+(() => {
+  'use strict';
+  if (window.RSMetaIdentity) return;
+  const platform = /(^|\.)facebook\.com$/.test(location.hostname) ? 'facebook' : /(^|\.)instagram\.com$/.test(location.hostname) ? 'instagram' : null;
+  if (!platform) return;
+  function identity() {
+    if (platform === 'facebook') {
+      const values = [];
+      for (const script of document.querySelectorAll('script')) {
+        const text = script.textContent;
+        if (!text?.includes('USER_ID')) continue;
+        for (const m of text.matchAll(/"USER_ID"\s*:\s*"(\d+)"/g)) if (m[1] !== '0') values.push(m[1]);
+      }
+      const ids = [...new Set(values)];
+      if (ids.length !== 1) throw Error('Identité Facebook active absente ou ambiguë.');
+      return {account_id:ids[0]};
+    }
+    const handles = [];
+    for (const a of document.querySelectorAll('a[href]')) {
+      if (!/^(profil|profile)$/i.test(a.textContent.trim())) continue;
+      const path = new URL(a.href,location.href).pathname;
+      const m = path.match(/^\/([a-zA-Z0-9_.]{1,30})\/$/);
+      if (m && a.querySelector('img[alt]')) handles.push(m[1].toLowerCase());
+    }
+    const names = [...new Set(handles)];
+    if (names.length !== 1) throw Error('Profil Instagram connecté indisponible : ouvrez Instagram avec ce compte.');
+    return {username:names[0]};
+  }
+  chrome.runtime.onMessage.addListener((msg,sender,respond)=>{
+    if(sender.id!==chrome.runtime.id || msg.type!=='x.task' || msg.task?.kind!==platform+'.whoami') return;
+    (async()=>{for(let n=0;n<30;n++){try{return{status:'done',result:identity()}}catch(e){if(n===29)throw e;await new Promise(r=>setTimeout(r,500))}}})()
+      .then(respond,e=>respond({status:'failed',error:e.message}));
+    return true;
+  });
+  window.RSMetaIdentity={platform,identity};
+  if (!window.RSMAX) return;
+  const label=platform==='facebook'?'Facebook':'Instagram';
+  const call=async(type)=>{const r=await chrome.runtime.sendMessage({type});if(!r?.ok)throw Error(r?.error||'Companion indisponible.');return r.data;};
+  window.RSMAX.register({platform,match:u=>new RegExp('(^|\\.)'+platform+'\\.com$').test(u.hostname),recipes:[
+    {id:platform+'.identity',localOnly:true,label:label+' — identifier mon compte',params:[],available:()=>true,async run(ctx){const w=await call('meta.identity');ctx.log('Identifiant '+label+' : '+w.account_id+(w.username?' · @'+w.username:''));return{reason:'Identité relevée.'}}},
+    {id:platform+'.session',localOnly:true,label:label+' — transmettre la session à RS-Max',params:[],available:()=>true,async run(ctx){const r=await call('meta.session.send');ctx.log(r.status==='connected'?'Session vérifiée sur le navigateur distant.':'Session reçue, vérification à terminer.');return{reason:'Transmission terminée.'}}}
+  ]});
+})();
