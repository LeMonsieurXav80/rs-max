--- a/tests/x-followers.test.cjs	1970-01-01 01:00:00
+++ b/tests/x-followers.test.cjs	2026-11-13 14:46:05
@@ -0,0 +1,38 @@
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {test} = require('node:test');
+const {JSDOM} = require('jsdom');
+
+const schema = (handle, count) => `<script type="application/ld+json" data-testid="UserProfileSchema-test">${JSON.stringify({
+  '@type':'ProfilePage', mainEntity:{'@type':'Person', additionalName:handle, interactionStatistic:[
+    {'@type':'InteractionCounter', interactionType:'https://schema.org/FollowAction', name:'Follows', userInteractionCount:count},
+    {'@type':'InteractionCounter', interactionType:'https://schema.org/SubscribeAction', name:'Friends', userInteractionCount:812},
+  ]}})}</script>`;
+
+function observe(body) {
+  const dom = new JSDOM(`<main><a href="/owner/verified_followers"><span>22,9 k</span> abonnés</a>${body}</main>`,
+    {url:'https://x.com/owner', runScripts:'outside-only'});
+  const w = dom.window;
+  w.RSMAX = {};
+  w.RSXMentions = {identity:() => ({username:'owner'})};
+  w.chrome = {runtime:{onMessage:{addListener() {}}}};
+  w.eval(readFileSync(join(__dirname, '../x/tasks.js'), 'utf8'));
+  try { return w.RSXTasks.followersObservation(); } finally { w.close(); }
+}
+
+test('X lit le compte exact d’abonnés dans le schéma du profil plutôt que le lien arrondi', () => {
+  const o = observe(schema('owner', 22673));
+  assert.equal(o.value, 22673);
+  assert.equal(o.precision, 'exact');
+  assert.equal(o.source, 'profile_schema');
+  assert.equal(o.display, '22,9 k abonnés');
+});
+
+test('X garde le lien arrondi quand le schéma décrit un autre profil ou manque', () => {
+  for (const body of [schema('someone', 50), '']) {
+    const o = observe(body);
+    assert.equal(o.precision, 'rounded');
+    assert.equal(o.value, 22900);
+  }
+});
