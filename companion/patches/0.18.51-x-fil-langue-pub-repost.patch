diff -ruN a10/tests/x-feed-markers.test.cjs b10/tests/x-feed-markers.test.cjs
--- a/tests/x-feed-markers.test.cjs	1970-01-01 01:00:00
+++ b/tests/x-feed-markers.test.cjs	2026-11-14 12:29:30
@@ -0,0 +1,38 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const {join} = require('node:path');
+const {JSDOM} = require('jsdom');
+
+const post = (id, inner) => `<article data-testid="tweet"><a href="/visitor">Visiteur</a><a href="/visitor/status/${id}"><time datetime="2026-11-14T07:00:00Z"></time></a>${inner}</article>`;
+
+function rows(html) {
+  const dom = new JSDOM(`<main>${html}</main>`, {url: 'https://x.com/home', runScripts: 'outside-only'});
+  try {
+    dom.window.eval(readFileSync(join(__dirname, '../x/dom.js'), 'utf8'));
+    return [...dom.window.document.querySelectorAll('article')].map(a => dom.window.RSXDom.snapshot(a));
+  } finally {
+    dom.window.close();
+  }
+}
+
+test('le fil X porte la langue marquée par X, les publicités et les reposts', () => {
+  const [fr, en, ad, repost] = rows([
+    post('1', '<div data-testid="tweetText" lang="fr">Belle séance de squat</div>'),
+    post('2', '<div data-testid="tweetText" lang="en">Leg day done</div>'),
+    `<div data-testid="placementTracking">${post('3', '<span>Ad</span><div data-testid="tweetText" lang="en">Buy now</div>')}</div>`,
+    post('4', '<span data-testid="socialContext">Coach a reposté</span><div data-testid="tweetText" lang="fr">WOD du jour</div>'),
+  ].join(''));
+  assert.equal(fr.lang, 'fr');
+  assert.equal(fr.promoted, false);
+  assert.equal(fr.reposted_by, undefined);
+  assert.equal(en.lang, 'en');
+  assert.equal(ad.promoted, true);
+  assert.equal(repost.reposted_by, true);
+  assert.equal(repost.social_context, 'Coach a reposté');
+});
+
+test('une publication sans texte n’a pas de langue', () => {
+  const [photo] = rows(post('5', '<div data-testid="tweetPhoto"><img alt="Image"></div>'));
+  assert.equal(photo.lang, null);
+});
