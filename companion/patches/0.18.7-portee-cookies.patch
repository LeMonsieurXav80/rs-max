+      const detail={url:'https://'+host+path,name:shadow.name,value:'',domain:shadow.domain,path,secure:shadow.secure,httpOnly:shadow.httpOnly,...(shadow.sameSite?{sameSite:shadow.sameSite}:{}),expirationDate:1};
+      try{await chrome.cookies.set(detail);}catch(e){const left=await chrome.cookies.getAll({domain:host,name:c.name});if(left.some(v=>v.domain===shadow.domain&&v.path===path))throw e;}
+      const left=await chrome.cookies.getAll({domain:host,name:c.name});
+      if(left.some(v=>v.domain===shadow.domain&&v.path===path))throw Error('Cookie de domaine hérité non supprimé : session non remplacée.');
+      removed++;
+    }
+  }
+  return removed;
+}
