+++ b/tiktok/submission-observer.js
@@ -0,0 +1,34 @@
+/* Monde principal : observation passive de l'accusé natif Studio, jamais un appel API. */
+(() => {
+  'use strict';
+  const event = 'rsmax:tiktok:submission';
+  const relevant = (url, method) => {
+    try { const u = new URL(url, location.href); return String(method).toUpperCase() === 'POST' && u.origin === location.origin && u.pathname === '/api/comment/publish/'; } catch { return false; }
+  };
+  const id = value => typeof value === 'string' && /^\d{1,30}$/.test(value) ? value : null;
+  const emit = (http, body) => {
+    try {
+      const c = body?.comment;
+      window.dispatchEvent(new CustomEvent(event, {detail: JSON.stringify({
+        http_status: http, status_code: Number.isInteger(body?.status_code) ? body.status_code : null,
+        comment_status: Number.isInteger(c?.status) ? c.status : null,
+        comment_id: id(c?.cid), parent_id: id(c?.reply_id), post_id: id(c?.aweme_id),
+        // Sert uniquement à rattacher le reçu à la saisie en cours, jamais journalisé.
+        text: typeof c?.text === 'string' ? c.text.slice(0, 500) : null,
+      })}));
+    } catch { /* L'observation ne doit jamais modifier le fonctionnement de Studio. */ }
+  };
+  const originalFetch = window.fetch;
+  if (originalFetch) window.fetch = function (...args) {
+    const input = args[0], wanted = relevant(typeof input === 'string' || input instanceof URL ? String(input) : input?.url, args[1]?.method || input?.method || 'GET');
+    const result = Reflect.apply(originalFetch, this, args);
+    if (wanted) result.then(response => { response.clone().json().then(body => emit(response.status, body)).catch(() => {}); }, () => {});
+    return result;
+  };
+  const open = XMLHttpRequest.prototype.open, send = XMLHttpRequest.prototype.send, requests = new WeakMap();
+  XMLHttpRequest.prototype.open = function (method, url, ...rest) { requests.set(this, relevant(url, method)); return Reflect.apply(open, this, [method, url, ...rest]); };
+  XMLHttpRequest.prototype.send = function (...args) {
+    if (requests.get(this)) this.addEventListener('load', () => { try { emit(this.status, this.responseType === 'json' ? this.response : JSON.parse(this.responseText)); } catch {} }, {once: true});
+    return Reflect.apply(send, this, args);
+  };
+})();
--- /dev/null
+++ b/tiktok/submission-receipt.js
@@ -0,0 +1,24 @@
+/* Le reçu est un diagnostic ; seule la relecture après reload fait preuve. */
+(() => {
+  'use strict';
+  let active = null;
+  const number = v => Number.isInteger(v) ? v : null;
+  const id = v => typeof v === 'string' && /^\d{1,30}$/.test(v) ? v : null;
+  window.addEventListener('rsmax:tiktok:submission', e => {
+    if (!active) return;
+    try {
+      const b = JSON.parse(e.detail);
+      if (b.text !== active.text) return;
+      active.receipt = {http_status: number(b.http_status), status_code: number(b.status_code), comment_status: number(b.comment_status), comment_id: id(b.comment_id), parent_id: id(b.parent_id), post_id: id(b.post_id), text_matched: true};
+      active.resolve?.(active.receipt);
+    } catch {}
+  });
+  window.RSTikTokSubmission = {start(text) {
+    const state = active = {text, receipt: null};
+    return {async finish() {
+      try {
+        return state.receipt || await new Promise(resolve => { const timer = setTimeout(() => resolve(null), 3000); state.resolve = value => { clearTimeout(timer); resolve(value); }; });
+      } finally { if (active === state) active = null; }
+    }};
+  }};
+})();
